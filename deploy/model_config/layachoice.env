# Model pins for the cap-router (LayaChoice) service.
#
# Injected by Compose as MODEL_SPEC_JSON at container creation. The image never
# contains this value and no host path is mounted. After editing:
#
#   docker compose up -d --force-recreate cap-router
#
# Compose recreates the container because its environment changed. A plain
# `docker compose restart` does NOT pick up a new env_file value.
#
# `revision` must be a full commit SHA. Every file listed under `files` is
# verified against its size and SHA256 before the new version is published;
# only then is `current` switched and the previous version removed.
