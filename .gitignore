# Local temp record (never committed)
docs/temp.md

# Trace / debug scratch (do not commit)
docs/trace_chat_prompt.md
scripts/trace_chat_prompt.py

# Local backup snapshot (nested git repo, never commit)
.delveta-snapshots/

# LayaChoice-v1 frozen bundle — the model-phase inputs and the two un-regenerable
# raw files; exempted from the generic `data/` rule above so they are committed.
# The generated `smoke/` subset stays ignored.
!fine_tuning/laya_finetune/V1/data/
fine_tuning/laya_finetune/V1/data/smoke/

# LayaChoice-v2 frozen dataset — the accepted 4-way (3 capability + REJECT) bundle;
# exempted from the generic `data/` rule above so it is committed, like V1.
!fine_tuning/laya_finetune/V2/data/

# LayaChoice-v2 data-construction chain (capture -> generate_final -> adjust_test_to_train);
# exempted from the generic `build/` rule above so the reproducible chain is committed.
!fine_tuning/laya_finetune/V2/build/

# LayaChoice V4 data_versions — documentation, construction code and checksum records only.
# The frozen JSONL bundles are hosted on Hugging Face
# (eric-ml-nlp/Delveta-LayaChoice-v2-Data) and must not be committed here.
fine_tuning/laya_finetune/data_versions/recall_threshold_*/
fine_tuning/laya_finetune/data_versions/message_id_map.jsonl
fine_tuning/laya_finetune/data_versions/dataset_construction/inputs/
# Retrieval intermediates and large derived artifacts; the 18 capability ids stay tracked.
fine_tuning/laya_finetune/data_versions/shared/*
!fine_tuning/laya_finetune/data_versions/shared/capability_ids.json

# Qwen3-0.6B parameter-extraction SFT bundle — the frozen train/validation/test
# splits, manifest and build reports are the reproduce-and-commit artifacts;
# `data/` is exempted from the generic rule above so the bundle is committed.
# Training checkpoints and exported model artifacts (later stages) stay ignored.
!fine_tuning/qwen_parameter_extraction_finetune/data/
fine_tuning/qwen_parameter_extraction_finetune/checkpoints/
fine_tuning/qwen_parameter_extraction_finetune/exports/
# Isolated smoke-test environment, local HF model cache and smoke outputs stay local.
fine_tuning/qwen_parameter_extraction_finetune/.venv/
fine_tuning/qwen_parameter_extraction_finetune/.hf_cache/
fine_tuning/qwen_parameter_extraction_finetune/smoke_out/
